{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --config vite.profile.config.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-profile server.js",
    "lint": "tsc --noEmit",
    "audit:surveillance": "tsx server/auditSurveillance.ts",
    "test": "node --import ./tests/fixtures/offline-network.mjs --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "community": "tsx communityServer.ts",
    "community:migrate": "tsx communityServer.ts --migrate",
    "community:migration-plan": "tsx scripts/community-migration-plan.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.11",
    "@rolldown/binding-wasm32-wasi": "^1.2.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-musl": "^1.2.11"
  }
