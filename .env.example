# Application port (3000 by default; Docker Compose sets PORT=3000)
PORT=3000
APP_PORT=3000

# Environment: production or development
NODE_ENV=production

# Separate read-only data credential for the external PHP paper bot (32+ random characters).
# Empty disables /api/paper/formations. Never commit a real token.
HOOK_PAPER_FEED_TOKEN=
# Share the EXISTING 75-candidate background budget across all six TFs (12-13 each).
HOOK_SCREENER_TIMEFRAMES=1m,5m,15m,1h,4h,1d
# Legacy single-TF setting, used only when HOOK_SCREENER_TIMEFRAMES is absent.
HOOK_SCREENER_TIMEFRAME=1h

# Legacy code-verification endpoint only; native Community registration does not use these.
ACCESS_CODES=

# Gemini API Key (optional, for AI pattern analysis):
GEMINI_API_KEY=

# Optional MyMemory contact email: boosts free headline translation from
# 5,000 to 50,000 characters/day. Without it, English headlines are shown
# if the anonymous daily translation quota is exhausted.
MYMEMORY_CONTACT_EMAIL=

# Shared H00K bot for Telegram notifications. Each user links their own Telegram chat in the app.
TELEGRAM_BOT_TOKEN=

# Optional read-only market-data metrics endpoint; requires a >=32-byte secret.
# Generate: openssl rand -hex 32; leave unset to disable /api/ops/market-data.
H00K_OPS_TOKEN=

# Emergency rollout switches: default ON; set to 0 and restart the app
# to restore prior behavior for the affected subsystem if staging finds a bug.
H00K_SHARED_STREAMS=1
H00K_ALERT_PRICE_WS=1
H00K_BINANCE_TICKER_WS=1
H00K_BYBIT_OI_WS=1

# Public quote wire optimization; default ON, each independently reversible.
H00K_QUOTE_CACHE=1
H00K_QUOTE_GZIP=1

# HookChart depth WS capacity, defaults remain identical to the original site.
# Increase only after a controlled load test on your own VPS.
H00K_MAX_DEPTH_CLIENTS=256
H00K_MAX_DEPTH_MARKETS=64

# Independent Community process. Copy real values to untracked .env, never Git.
DATABASE_URL=
COMMUNITY_INTERNAL_ORIGIN=http://127.0.0.1:3001
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=3001
APP_ORIGIN=https://h00k.top
# Optional additional exact frontend origins, comma-separated; no wildcards.
COMMUNITY_PUBLIC_ORIGINS=
# Optional personal profile hosts, e.g. ivan.h00k.top. Requires wildcard DNS/TLS.
COMMUNITY_PROFILE_DOMAIN=h00k.top
# Community-only UI on APP_ORIGIN; does not start the market server.
COMMUNITY_STANDALONE_ENABLED=0
# Generate once with: openssl rand -base64 32. Back up securely before using connectors/MFA.
COMMUNITY_ENCRYPTION_KEY=
SMTP_URL=
MAIL_FROM=
COMMUNITY_MEDIA_DIR=./server/data/community-media
# Set only exact trusted proxy addresses/CIDRs for your deployment.
H00K_TRUST_PROXY=
COMMUNITY_TRUST_PROXY=loopback
COMMUNITY_MODERATOR_IDS=
# Keep OFF until exchange egress is isolated or all shared-IP consumers share a budget.
COMMUNITY_EXCHANGE_EGRESS_ISOLATED=0
COMMUNITY_SYNC_ENABLED=0
# compose.community.yaml only; URL must use the same password and postgres:5432.
COMMUNITY_DB_PASSWORD=
COMMUNITY_DATABASE_URL=
